# ---------------------------------------------------------------------------
# Browser (exposed to the frontend by Vite). Only public values here.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public URL of the API. Falls back to API_URL when unset.
VITE_API_URL=

# ---------------------------------------------------------------------------
# Server only. NEVER prefix these with VITE_.
# ---------------------------------------------------------------------------
SUPABASE_URL=
# The anon key is public; the server uses it to run queries as the signed-in
# user so Row Level Security applies. Defaults to VITE_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
# Optional: model with structured-output support.
OPENAI_MODEL=gpt-4o-mini

# Frontend origin (used for CORS and post-OAuth redirects) and API origin.
APP_URL=http://localhost:5173
API_URL=http://localhost:8787
# Optional comma-separated extra CORS origins (e.g. Vercel preview URLs).
CORS_ORIGINS=

PORT=8787
NODE_ENV=development
